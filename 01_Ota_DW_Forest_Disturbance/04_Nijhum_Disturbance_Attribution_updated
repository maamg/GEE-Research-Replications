});

// ------------------------------------------------------------
// 23. নভেম্বর–ডিসেম্বরের Sentinel-2 Composite তৈরি
// ------------------------------------------------------------
var getS2Composite = function(year) {
  var start = ee.Date.fromYMD(year, 11, 1);
  var end = ee.Date.fromYMD(year + 1, 1, 1);
  return s2Clean.filterDate(start, end).median().clip(aoi);
};
