    lineWidth: 2,
    pointSize: 6
  });
print(persistentLongChart);

// ------------------------------------------------------------
// 48. গুছানো বার্ষিক মানের তালিকা প্রিন্ট
// ------------------------------------------------------------
print('Candidate years:', candidateLongSeries.aggregate_array('year'));
print('Candidate NDVI:', candidateLongSeries.aggregate_array('NDVI'));
print('Candidate MNDWI:', candidateLongSeries.aggregate_array('MNDWI'));
print('Persistent patch years:', persistentLongSeries.aggregate_array('year'));
print('Persistent patch NDVI:', persistentLongSeries.aggregate_array('NDVI'));
print('Persistent patch MNDWI:', persistentLongSeries.aggregate_array('MNDWI'));

// ============================================================
// যাচাইয়ের লক্ষ্য:
// ২০১৭–২০২১ সময়ে মানগুলো তুলনামূলক স্থির ছিল কি?
// Dynamic World-এ trees কমার সময়েই NDVI-ও কমতে শুরু করেছে কি?
// trees কমার সঙ্গে MNDWI ক্রমে কম ঋণাত্মক বা ধনাত্মক হয়েছে কি?
// উদাহরণ (নিচের মানগুলো কেবল ব্যাখ্যামূলক, প্রকৃত ফল নয়):
// trees-Probability: 0.69 → 0.58 → 0.39 → 0.20 → 0.14
// NDVI:              0.60 → 0.56 → 0.48 → 0.35 → 0.25
// MNDWI:            -0.40 → -0.38 → -0.30 → -0.20 → -0.10
// এমন ধারা থাকলে উদ্ভিদের সক্রিয়তা কমা ও পৃষ্ঠের আর্দ্রতা বৃদ্ধির সম্ভাবনা জোরালো হয়।
// ------------------------------------------------------------

// ============================================================
// অংশ M
// বৃক্ষ-হ্রাসের সম্ভাব্য পিক্সেলগুলোর ক্ষেত্রফল নির্ণয়
// ============================================================
//
// গুরুত্বপূর্ণ: এই আয়তন শুধু Probability-ভিত্তিক শর্ত পূরণ করা পিক্সেলের ক্ষেত্রফল।
// তাই এগুলোকে Candidate Tree-Decline Area বা Persistent Candidate Area বলব;
// যাচাই ছাড়া নিশ্চিত বন উজাড়ের (Deforestation) আয়তন বলা যাবে না।
// ------------------------------------------------------------
// ------------------------------------------------------------
// 49. প্রতি পিক্সেলের ক্ষেত্রফল হেক্টরে রূপান্তর
// ------------------------------------------------------------
// ee.Image.pixelArea() বর্গমিটারে আয়তন দেয়; ১ হেক্টর = ১০,০০০ বর্গমিটার।
// ------------------------------------------------------------
var pixelAreaHa = ee.Image.pixelArea().divide(10000).rename('area_ha');

// ------------------------------------------------------------
// 50. সহায়ক ফাংশন:
// যেকোনো Boolean Mask-এর আওতাধীন ক্ষেত্রফল হিসাব
// ------------------------------------------------------------
// Boolean Mask-এ 1 থাকা পিক্সেলের pixelArea() যোগ করে হেক্টর পাওয়া যায়।
var calculateAreaHa = function(maskImage) {
  var area = pixelAreaHa
    .updateMask(maskImage)
    .reduceRegion({
      reducer: ee.Reducer.sum(),
      geometry: aoi,
      scale: 10,
      maxPixels: 1e9,
      tileScale: 4
    });
  return ee.Number(area.get('area_ha'));
};

// ------------------------------------------------------------
// 51. সংরক্ষিত এলাকার মোট আয়তন
// ------------------------------------------------------------
var totalAOIAreaHa = ee.Number(aoi.area()).divide(10000);
print('Total Nijhum Dwip AOI area (ha):', totalAOIAreaHa);

// ------------------------------------------------------------
// 52. ২০১৭ সালের Baseline উচ্চ-trees এলাকার আয়তন
// ------------------------------------------------------------
// শর্ত: ২০১৭ সালের trees-Probability > 0.60।
var baselineHighTreeAreaHa = calculateAreaHa(baselineForestMask);
print('2017 high-tree baseline area (ha):', baselineHighTreeAreaHa);

// ------------------------------------------------------------
// 53. সম্ভাব্য trees-Probability হ্রাস পাওয়া এলাকার আয়তন
// ------------------------------------------------------------
// শর্ত: ২০১৭-এ trees > 0.60 এবং পরবর্তী কোনো বছরে সর্বোচ্চ trees-হ্রাস > 0.25।
var candidateDeclineAreaHa = calculateAreaHa(candidateDisturbance);
print('Candidate tree-decline area (ha):', candidateDeclineAreaHa);

// ------------------------------------------------------------
// 54. ধারাবাহিক (Persistent) trees-হ্রাসের সম্ভাব্য আয়তন
// ------------------------------------------------------------
// শর্ত: ২০১৭-এ trees > 0.60 এবং পরবর্তী অন্তত ২টি পরপর বছরে trees-হ্রাস > 0.25।
var persistentDeclineAreaHa = calculateAreaHa(persistentCandidate);
print('Persistent tree-decline candidate area (ha):', persistentDeclineAreaHa);

// ------------------------------------------------------------
// 55. Baseline এলাকার তুলনায় Candidate Area (%)
// ------------------------------------------------------------
var candidatePercentBaseline = candidateDeclineAreaHa.divide(baselineHighTreeAreaHa).multiply(100);
print('Candidate decline area (% of 2017 high-tree baseline):', candidatePercentBaseline);

// ------------------------------------------------------------
// 56. Baseline এলাকার তুলনায় Persistent Area (%)
// ------------------------------------------------------------
var persistentPercentBaseline = persistentDeclineAreaHa
  .divide(baselineHighTreeAreaHa)
  .multiply(100);
print('Persistent decline area (% of 2017 high-tree baseline):', persistentPercentBaseline);

// ------------------------------------------------------------
// 57. পুরো জাতীয় উদ্যানের তুলনায় Persistent Area (%)
// ------------------------------------------------------------
var persistentPercentAOI = persistentDeclineAreaHa.divide(totalAOIAreaHa).multiply(100);
print('Persistent decline area (% of total AOI):', persistentPercentAOI);

// ------------------------------------------------------------
// 58. ক্ষেত্রফলের সারসংক্ষেপ টেবিল তৈরি
// ------------------------------------------------------------
var areaSummary = ee.FeatureCollection([
  ee.Feature(null, {
    total_AOI_ha: totalAOIAreaHa,
    baseline_high_tree_2017_ha: baselineHighTreeAreaHa,
    candidate_tree_decline_ha: candidateDeclineAreaHa,
    persistent_tree_decline_ha: persistentDeclineAreaHa,
    candidate_pct_of_baseline: candidatePercentBaseline,
    persistent_pct_of_baseline: persistentPercentBaseline,
    persistent_pct_of_AOI: persistentPercentAOI
  })
]);
print('TREE-DECLINE AREA SUMMARY:', areaSummary);

// ============================================================
// অংশ N
// সর্বোচ্চ বৃক্ষ-হ্রাসের বছর অনুযায়ী সারসংক্ষেপ
// ============================================================
//
// উদ্দেশ্য: প্রতিটি Persistent পিক্সেলের ২০১৮–২০২৫ সময়ের মধ্যে কোন বছরে ২০১৭-এর তুলনায়
// trees-Probability সবচেয়ে বেশি কমেছে তা বের করা; এরপর বছরভিত্তিক ক্ষেত্রফল (হেক্টর) হিসাব।
// সতর্কতা: এটি সর্বোচ্চ হ্রাসের বছর; হ্রাস *প্রথম শুরু* হওয়ার বছর নাও হতে পারে।
// ------------------------------------------------------------
// 59. Baseline-পরবর্তী বছরগুলোর তালিকা
// ------------------------------------------------------------
var changeYears = ee.List.sequence(2018, 2025);

// ------------------------------------------------------------
// 60. সর্বোচ্চ বৃক্ষ-হ্রাসের বছর অনুযায়ী ক্ষেত্রফল
// ------------------------------------------------------------
// প্রতিটি সর্বোচ্চ-হ্রাসের বছরের জন্য আলাদা Mask নিয়ে আয়তন গণনা।
var yearOfMaxDropSummary = ee.FeatureCollection(changeYears.map(function(year) {
  year = ee.Number(year);
  // নির্দিষ্ট বছরে সর্বোচ্চ trees-হ্রাস হওয়া পিক্সেল নির্বাচন।
  var yearMask = maxDropYear
    .eq(year)
    // শুধু Persistent Candidate পিক্সেল হিসাবের মধ্যে রাখা।
    .and(persistentCandidate);
  // পিক্সেলের ক্ষেত্রফল হেক্টরে হিসাব।
  var areaDict = pixelAreaHa
    .updateMask(yearMask)
    .reduceRegion({
      reducer: ee.Reducer.sum(),
      geometry: aoi,
      scale: 10,
      maxPixels: 1e9,
      tileScale: 4
    });
  // কোনো বছরে পিক্সেল না থাকলে null-এর বদলে 0 নেওয়া।
  var areaHa = ee.Number(ee.Algorithms.If(areaDict.contains('area_ha'), areaDict.get('area_ha'), 0));
  // মোট Persistent Candidate এলাকার কত শতাংশ তা নির্ণয়।
  var percentPersistent = areaHa.divide(persistentDeclineAreaHa).multiply(100);
  return ee.Feature(null, {
    year: year,
    area_ha: areaHa,
    pct_of_persistent_area: percentPersistent
  });
}));
print('YEAR OF MAXIMUM TREE DROP — AREA SUMMARY:', yearOfMaxDropSummary);

// ------------------------------------------------------------
// 61. সাজানো বছরের তালিকা
// ------------------------------------------------------------
print('Years:', yearOfMaxDropSummary.aggregate_array('year'));
print('Area by maximum-drop year (ha):', yearOfMaxDropSummary.aggregate_array('area_ha'));
print('% of persistent area by year:', yearOfMaxDropSummary
  .aggregate_array('pct_of_persistent_area'));

// ------------------------------------------------------------
// 62. গুণগত যাচাই (QC):
// প্রতিবছরের সর্বোচ্চ হ্রাসের এলাকা যোগ করে মিলিয়ে দেখা
// ------------------------------------------------------------
// বছরভিত্তিক ক্ষেত্রফলের যোগফল মোট Persistent Area-র প্রায় সমান হওয়া উচিত।
// আগের ফলাফলের আনুমানিক রেফারেন্স: 193.07 হেক্টর (বর্তমান রান-এ ভিন্ন হতে পারে)।
var summedYearAreaHa = ee.Number(yearOfMaxDropSummary.aggregate_sum('area_ha'));
print('Sum of year-specific persistent areas (ha):', summedYearAreaHa);
print('Previously calculated persistent area (ha):', persistentDeclineAreaHa);

// ------------------------------------------------------------
// 63. QC-এর জন্য ক্ষেত্রফলের পার্থক্য বের করা
// ------------------------------------------------------------
var yearAreaDifference = summedYearAreaHa.subtract(persistentDeclineAreaHa);
print('QC difference (ha):', yearAreaDifference);

// ------------------------------------------------------------
// 64. বছরভিত্তিক Bar Chart
// ------------------------------------------------------------
var yearOfMaxDropChart = ui.Chart.feature.byFeature(yearOfMaxDropSummary, 'year', ['area_ha'])
  .setChartType('ColumnChart')
  .setOptions({
    title: 'Persistent Tree-Decline Area by Year of Maximum Drop',
    hAxis: { title: 'Year' },
    vAxis: { title: 'Area (ha)' },
    legend: { position: 'none' }
  });
print(yearOfMaxDropChart);

// ============================================================
// অংশ O
// ধারাবাহিক বৃক্ষ-হ্রাস প্রথম শুরু হওয়ার বছর
// ============================================================
// সংজ্ঞা: সবচেয়ে আগে পাওয়া এমন পরপর দুই বছরের জোড়ার প্রথম বছর,
// যার *উভয়* বছরে ২০১৭-এর তুলনায় trees-Probability হ্রাস dropThreshold-এর বেশি।
// উদাহরণ: ২০১৮-তে হ্রাস, ২০১৯–২০২০-তে নয়, ২০২১–২০২২-তে হ্রাস → শুরুর বছর ২০২১।
// সতর্কতা: এটি Threshold-ভিত্তিক কাজের সংজ্ঞা; পরিসংখ্যানগত Significance Test নয়।
// ============================================================
// ------------------------------------------------------------
// 65. পরপর বছরের প্রতিটি Pair-কে তার শুরুর বছর হিসেবে দেখানো
// প্রতিটি পরপর বছরের Pair-এর শুরুর বছর নির্ণয়
// ------------------------------------------------------------
// consecutivePairImages-এ ২০১৮–১৯ থেকে ২০২৪–২৫ পর্যন্ত পরপর বছরের জোড়া আছে।
// যেকোনো জোড়ার উভয় বছর Threshold ছাড়ানো পিক্সেলেই মান 1।
var firstPersistentDeclineYearCollection = consecutivePairImages.map(function(image) {
  var startYear = ee.Number(image.get('start_year')).toInt();
  // যে জোড়া পরপর হ্রাস দেখায়, তার শুরুর বছর দিয়ে ইমেজ তৈরি।
  var startYearImage = ee.Image.constant(startYear)
    .rename('first_persistent_decline_year')
    .toInt16()
    // শুধু ওই জোড়ায় ধারাবাহিক হ্রাস হওয়া পিক্সেল রাখা।
    .updateMask(image.eq(1))
    // চূড়ান্ত Persistent Candidate পিক্সেলের বাইরে সব বাদ দেওয়া।
    .updateMask(persistentCandidate);
  return startYearImage;
});

// ------------------------------------------------------------
// 66. Persistent হ্রাসের সবচেয়ে প্রথম শুরুর বছর বের করা
// ------------------------------------------------------------
// একাধিক বৈধ জোড়ার শুরুর বছর ২০২১, ২০২২, ২০২৪ হলে `.min()` দিয়ে ২০২১ নেওয়া হয়।
// ------------------------------------------------------------
// প্রথম বৈধ জোড়ার শুরুর বছর নিতে .min() ব্যবহার।
var firstPersistentDeclineYear = firstPersistentDeclineYearCollection
  .min()
  .rename('first_persistent_decline_year')
  .toInt16();

// ------------------------------------------------------------
// সাময়িক নাম-সামঞ্জস্য: অংশ P ও R-এ firstDeclineYear ব্যবহৃত হয়েছে।
// এখানে সেটিকে উন্নত firstPersistentDeclineYear-ই ধরা হয়েছে, যাতে পরের অংশগুলোর কোড বদলাতে না হয়।
var firstDeclineYear = firstPersistentDeclineYear;

// ------------------------------------------------------------
// 67. প্রথম Persistent হ্রাসের বছর মানচিত্রে দেখানো
// ------------------------------------------------------------
Map.addLayer(firstPersistentDeclineYear, {
  min: 2018,
  max: 2024,
  palette: ['blue', 'cyan', 'green', 'yellow', 'orange', 'red', 'magenta']
}, 'First Persistent Tree-Decline Year', true);

// ------------------------------------------------------------
// 68. একবার Grouped Reduction করে বছরভিত্তিক ক্ষেত্রফল হিসাব
// ------------------------------------------------------------
// প্রতি বছরের জন্য আলাদা reduceRegion() না চালিয়ে একবারেই Grouped Reduction করা হচ্ছে।
// Band 0 = area_ha; Band 1 = first_persistent_decline_year (যে বছর অনুযায়ী গ্রুপ হবে)।
var firstPersistentAreaImage = pixelAreaHa.addBands(firstPersistentDeclineYear);
// Reducer.sum().group() দিয়ে একই সঙ্গে বছরভিত্তিক Area Group করা।
var firstPersistentGroupedResult = firstPersistentAreaImage.reduceRegion({
  reducer: ee.Reducer.sum().group({ groupField: 1, groupName: 'year' }),
  geometry: aoi,
  scale: 10,
  maxPixels: 1e9,
  tileScale: 4
});

// ------------------------------------------------------------
// 69. Grouped Result থেকে টেবিল তৈরি
// ------------------------------------------------------------
var firstPersistentGroups = ee.List(firstPersistentGroupedResult.get('groups'));
var firstPersistentDeclineSummary = ee.FeatureCollection(firstPersistentGroups.map(function(item) {
  item = ee.Dictionary(item);
  var year = ee.Number(item.get('year')).toInt();
  var areaHa = ee.Number(item.get('sum'));
  var percentage = areaHa.divide(persistentDeclineAreaHa).multiply(100);
  return ee.Feature(null, { year: year, area_ha: areaHa, pct_of_persistent_area: percentage });
}))
  .sort('year');
print('FIRST PERSISTENT DECLINE YEAR — AREA SUMMARY:', firstPersistentDeclineSummary);

// ------------------------------------------------------------
// 70. হিসাবের মিল যাচাই (QC)
// ------------------------------------------------------------
// সব শুরুর বছরের ক্ষেত্রফলের যোগফল মোট Persistent Area-র প্রায় সমান হওয়া উচিত।
var firstPersistentAreaTotal = ee.Number(firstPersistentDeclineSummary.aggregate_sum('area_ha'));
print('First-persistent-onset area total (ha):', firstPersistentAreaTotal);
print('Persistent candidate area (ha):', persistentDeclineAreaHa);
print('QC difference (ha):', firstPersistentAreaTotal.subtract(persistentDeclineAreaHa));

// ------------------------------------------------------------
// 71. বছরভিত্তিক Bar Chart
// ------------------------------------------------------------
var firstPersistentDeclineChart = ui.Chart.feature.byFeature(firstPersistentDeclineSummary, 'year', ['area_ha'])
  .setChartType('ColumnChart')
  .setOptions({
    title: 'Persistent Tree-Decline Area by First Persistent Decline Year',
    hAxis: { title: 'First Year of Consecutive Decline' },
    vAxis: { title: 'Area (ha)' },
    legend: { position: 'none' }
  });
print(firstPersistentDeclineChart);

// ============================================================
// অংশ O-B
// ধারাবাহিক হ্রাস শুরুর পরের সময়ের সর্বোচ্চ হ্রাস
// ============================================================
//
// উদ্দেশ্য: প্রতিটি Persistent পিক্সেলে প্রথম Persistent শুরুর বছর নির্ণয় করে
// তার আগের সব বছর বাদ দিয়ে শুরুর বছর থেকে সর্বোচ্চ trees-হ্রাসের বছর খুঁজে বের করা।
// এতে আগে ঘটে যাওয়া বিচ্ছিন্ন হ্রাসকে Persistent পর্যায়ের সর্বোচ্চ হ্রাস ধরা হবে না।
// ============================================================
// ------------------------------------------------------------
// A. Persistent হ্রাস শুরুর আগের বছরগুলো বাদ দেওয়া
// শুরুর বছর থেকে পরের বছরগুলোর Drop Image ব্যবহার
// ------------------------------------------------------------
var persistentEpisodeDrops = annualDrops.map(function(image) {
  var year = ee.Number(image.get('year'));
  // পিক্সেলভিত্তিক তুলনার জন্য Image Year-কে Constant Raster-এ রূপান্তর।
  var yearImage = ee.Image.constant(year).toInt16();
  // শুধু `current year >= firstPersistentDeclineYear` হলে বছরের ইমেজ রাখা।
  var afterOnsetMask = yearImage.gte(firstPersistentDeclineYear);
  return image
    .updateMask(afterOnsetMask)
    .updateMask(persistentCandidate)
    .copyProperties(image, ['year', 'system:time_start']);
});

// ------------------------------------------------------------
// B. Persistent পর্যায়ে সর্বোচ্চ trees-হ্রাস নির্ণয়
// ------------------------------------------------------------
// শুরু হওয়ার আগের বছরের হ্রাস বাদ দিয়ে নতুন সর্বোচ্চ হ্রাস নির্ণয়।
var persistentEpisodeMaxComposite = persistentEpisodeDrops.qualityMosaic('tree_drop');

// ------------------------------------------------------------
// C. সর্বোচ্চ trees-হ্রাসের পরিমাণ
// ------------------------------------------------------------
var persistentEpisodeMaxTreeDrop = persistentEpisodeMaxComposite
  .select('tree_drop')
  .rename('persistent_episode_max_tree_drop')
  .updateMask(persistentCandidate);

// ------------------------------------------------------------
// D. Persistent পর্যায়ের সর্বোচ্চ হ্রাসের বছর
// ------------------------------------------------------------
var persistentEpisodeMaxDropYear = persistentEpisodeMaxComposite
  .select('drop_year')
  .rename('persistent_episode_max_drop_year')
  .toInt16()
  .updateMask(persistentCandidate);

// ------------------------------------------------------------
// E. মানচিত্রে প্রদর্শন
// ------------------------------------------------------------
Map.addLayer(persistentEpisodeMaxDropYear, {
  min: 2018,
  max: 2025,
  palette: ['blue', 'cyan', 'green', 'yellow', 'orange', 'red', 'purple', 'magenta']
}, 'Maximum Drop Year — Persistent Episode', false);

// ------------------------------------------------------------
// F. পরীক্ষা:
// পুরোনো পদ্ধতিতে কত এলাকায় সর্বোচ্চ হ্রাস শুরু হওয়ার আগেই ঘটেছিল?
// ------------------------------------------------------------
// আগের পদ্ধতিতে যেসব পিক্সেলে Lag ঋণাত্মক হতো, সেগুলোর আয়তন যাচাই।
var oldMaximumBeforePersistentOnset = maxDropYear
  .lt(firstPersistentDeclineYear)
  .and(persistentCandidate);
var oldMaximumBeforeOnsetAreaHa = calculateAreaHa(oldMaximumBeforePersistentOnset);
print('Area where OLD maximum occurred before persistent onset (ha):', oldMaximumBeforeOnsetAreaHa);

// ------------------------------------------------------------
// G. নতুন Lag-এর সর্বনিম্ন ও সর্বোচ্চ মান পরীক্ষা
// ------------------------------------------------------------
var persistentEpisodeLagCheck = persistentEpisodeMaxDropYear
  .subtract(firstPersistentDeclineYear)
  .rename('persistent_episode_lag');
var lagCheckStats = persistentEpisodeLagCheck.reduceRegion({
  reducer: ee.Reducer.minMax(),
  geometry: aoi,
  scale: 10,
  maxPixels: 1e9,
  tileScale: 4
});
print('Persistent-episode lag min/max:', lagCheckStats);

// ============================================================
// অংশ P
// হ্রাস শুরু থেকে সর্বোচ্চ হ্রাস পর্যন্ত সময়ের ব্যবধান
// ============================================================
//
// উদ্দেশ্য: Persistent হ্রাস হঠাৎ, দ্রুত, ধীরে নাকি দীর্ঘ সময় ধরে হয়েছে তা বোঝা।
// Lag (বছর) = maxDropYear − firstDeclineYear।
// ------------------------------------------------------------
// 70. শুরু থেকে সর্বোচ্চ হ্রাস পর্যন্ত Lag-এর ইমেজ
// ------------------------------------------------------------
// Lag = সর্বোচ্চ হ্রাসের বছর − Persistent শুরুর বছর; ফল ০ বা বেশি হওয়ার কথা।
var declineLagYears = persistentEpisodeMaxDropYear
  .subtract(firstPersistentDeclineYear)
  .rename('lag_years')
  .toInt16()
  .updateMask(persistentCandidate);
Map.addLayer(declineLagYears, {
  min: 0,
  max: 7,
  palette: ['red', 'orange', 'yellow', 'lightgreen', 'green', 'cyan', 'blue', 'purple']
}, 'Onset-to-Maximum Decline Lag', true);

// ------------------------------------------------------------
// 71. Lag-এর বিভিন্ন বছরের তালিকা
// ------------------------------------------------------------
var lagValues = ee.List.sequence(0, 7);

// ------------------------------------------------------------
// 72. Lag অনুযায়ী ক্ষেত্রফলের হিসাব
// ------------------------------------------------------------
var lagSummary = ee.FeatureCollection(lagValues.map(function(lag) {
  lag = ee.Number(lag);
  var lagMask = declineLagYears.eq(lag);
  var areaDict = pixelAreaHa
    .updateMask(lagMask)
    .reduceRegion({
      reducer: ee.Reducer.sum(),
      geometry: aoi,
      scale: 10,
      maxPixels: 1e9,
      tileScale: 4
    });
  var areaHa = ee.Number(ee.Algorithms.If(areaDict.contains('area_ha'), areaDict.get('area_ha'), 0));
  var percentPersistent = areaHa.divide(persistentDeclineAreaHa).multiply(100);
  return ee.Feature(null, {
    lag_years: lag,
    area_ha: areaHa,
    pct_of_persistent_area: percentPersistent
  });
}));
print('ONSET-TO-MAXIMUM LAG SUMMARY:', lagSummary);

// ------------------------------------------------------------
// 73. ক্ষেত্রফল মিলিয়ে দেখা (QC)
// ------------------------------------------------------------
var lagAreaSum = ee.Number(lagSummary.aggregate_sum('area_ha'));
print('Sum of lag-class areas (ha):', lagAreaSum);
print('Persistent candidate area (ha):', persistentDeclineAreaHa);

// ------------------------------------------------------------
// 74. Lag অনুযায়ী Bar Chart
// ------------------------------------------------------------
var lagChart = ui.Chart.feature.byFeature(lagSummary, 'lag_years', ['area_ha'])
  .setChartType('ColumnChart')
  .setOptions({
    title: 'Persistent Tree-Decline Area by Onset-to-Maximum Lag',
    hAxis: { title: 'Lag (years)' },
    vAxis: { title: 'Area (ha)' },
    legend: { position: 'none' }
