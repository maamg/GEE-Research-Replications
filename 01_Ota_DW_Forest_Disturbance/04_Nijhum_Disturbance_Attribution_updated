//
// উদ্দেশ্য: Dynamic World-এ trees-Probability কমার সঙ্গে Sentinel-2-এর সূচকও বদলেছে কি না যাচাই।
// NDVI = উদ্ভিদের সবুজত্ব/সক্রিয়তার সূচক; MNDWI = পৃষ্ঠজল/আর্দ্রতার সূচক।
// ------------------------------------------------------------
// 26. Sentinel-2 ইমেজে NDVI ও MNDWI যোগের ফাংশন
// ------------------------------------------------------------
// Sentinel-2 ব্যান্ড দিয়ে সূচক গণনা:
// NDVI  = (B8 - B4) / (B8 + B4)
// MNDWI = (B3 - B11) / (B3 + B11)
// B8 = NIR (নিকট অবলোহিত); B4 = Red (লাল); B3 = Green (সবুজ); B11 = SWIR (স্বল্পতরঙ্গ অবলোহিত)।
// B11 = SWIR (স্বল্পতরঙ্গ অবলোহিত)।
// ------------------------------------------------------------
var addIndices = function(image) {
  // normalizedDifference() দিয়ে দুটি সূচক আলাদা ব্যান্ডে যোগ করা হচ্ছে।
  var ndvi = image.normalizedDifference(['B8', 'B4']).rename('NDVI');
  var mndwi = image.normalizedDifference(['B3', 'B11']).rename('MNDWI');
  return image.addBands(ndvi).addBands(mndwi);
};

