// অংশ J
// ২০১৭–২০২৫ সময়জুড়ে NDVI ও MNDWI-এর পরিবর্তন
// ============================================================
//
// উদ্দেশ্য: দীর্ঘমেয়াদি Dynamic World trees-হ্রাসের সঙ্গে Sentinel-2-এর NDVI/MNDWI-ও বদলায় কি না দেখা।
// দ্রষ্টব্য: এই স্ক্রিপ্টে Sentinel-2 SR Harmonized-এর দীর্ঘমেয়াদি যাচাই ২০১৭–২০২৫।
// ------------------------------------------------------------
// ------------------------------------------------------------
// 39. দীর্ঘমেয়াদি Sentinel-2 Surface Reflectance কালেকশন লোড
// ------------------------------------------------------------
// সকল বছর একই মৌসুম (নভেম্বর–ডিসেম্বর) নিয়ে তুলনা করা হচ্ছে।
var s2Long = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(aoi)
  .filterDate('2017-01-01', '2026-01-01');
var csPlusLong = ee.ImageCollection('GOOGLE/CLOUD_SCORE_PLUS/V1/S2_HARMONIZED');
// Cloud Score+-এর মান যাচাইয়ের ব্যান্ড যুক্ত করা হচ্ছে।
var s2LongLinked = s2Long.linkCollection(csPlusLong, ['cs_cdf']);
// মেঘ বা নিম্নমানের পর্যবেক্ষণের পিক্সেল বাদ দেওয়া হচ্ছে।
var s2LongClean = s2LongLinked.map(function(image) {
  return image.updateMask(image.select('cs_cdf').gte(0.60));
});

// ------------------------------------------------------------
// 40. NDVI ও MNDWI যোগ করার ফাংশন
// ------------------------------------------------------------
var addLongIndices = function(image) {
  var ndvi = image.normalizedDifference(['B8', 'B4']).rename('NDVI');
  var mndwi = image.normalizedDifference(['B3', 'B11']).rename('MNDWI');
  return image.addBands(ndvi).addBands(mndwi);
};

// ------------------------------------------------------------
// 41. গবেষণার বছরগুলোর তালিকা তৈরি
// ------------------------------------------------------------
var indexYears = ee.List.sequence(2017, 2025);
print('Sentinel-2 index years:', indexYears);

// ------------------------------------------------------------
// 42. প্রতিটি বছরের নভেম্বর–ডিসেম্বরের একটি করে Composite
// ------------------------------------------------------------
// ধাপ: প্রতিবছরের নভেম্বর–ডিসেম্বরের Sentinel-2 ইমেজ → Cloud Mask → Median Composite → NDVI/MNDWI।
// ২০২৩–২০২৫ সালের যাচাইয়ের একই পদ্ধতি এখানে সব বছরে প্রয়োগ করা হয়েছে।
var annualIndexCollection = ee.ImageCollection.fromImages(indexYears.map(function(year) {
  year = ee.Number(year);
  var start = ee.Date.fromYMD(year, 11, 1);
  var end = ee.Date.fromYMD(year.add(1), 1, 1);
  var yearlyS2 = s2LongClean.filterDate(start, end);
  // প্রতিবছরের নভেম্বর–ডিসেম্বরের Median Composite।
  var annualComposite = yearlyS2.median().clip(aoi);
  // Composite থেকে NDVI ও MNDWI গণনা।
  var annualIndices = addLongIndices(annualComposite).select(['NDVI', 'MNDWI']);
  return annualIndices
    .set('year', year)
    .set('system:time_start', ee.Date.fromYMD(year, 12, 1).millis())
    .set('image_count', yearlyS2.size());
}));
print('Annual NDVI + MNDWI collection:', annualIndexCollection);

// ------------------------------------------------------------
// 43. প্রতি বছর Sentinel-2-এর কতটি ইমেজ আছে, যাচাই
// ------------------------------------------------------------
// পুরোনো বছরগুলোতে Sentinel-2 SR-এর পর্যবেক্ষণ কম থাকতে পারে, তাই সংখ্যা যাচাই জরুরি।
var indexImageCounts = ee.FeatureCollection(annualIndexCollection.map(function(image) {
  return ee.Feature(null, { year: image.get('year'), image_count: image.get('image_count') });
}));
print('Sentinel-2 observations used per year:', indexImageCounts);

// ============================================================
// অংশ K
// নির্বাচিত পিক্সেলের দীর্ঘমেয়াদি সূচক বিশ্লেষণ
// ============================================================
// ------------------------------------------------------------
// 44. Candidate Point থেকে দীর্ঘমেয়াদি সূচকের মান বের করা
// ------------------------------------------------------------
// বিশ্লেষণের Scale = 20 মিটার।
// কারণ MNDWI-তে B11 লাগে, যার মূল Spatial Resolution 20 মিটার।
// ------------------------------------------------------------
var analysisScale = 20;
var candidateLongSeries = ee.FeatureCollection(annualIndexCollection.map(function(image) {
  var values = image.reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: candidatePoint,
    scale: analysisScale,
    bestEffort: true
  });
  return ee.Feature(null, values)
    .set('year', image.get('year'))
    .set('image_count', image.get('image_count'));
}));
print('Candidate-point NDVI + MNDWI — 2017–2025:', candidateLongSeries);

// ------------------------------------------------------------
// 45. Candidate Point-এর দীর্ঘমেয়াদি রেখাচিত্র
// ------------------------------------------------------------
var candidateLongChart = ui.Chart.feature.byFeature(candidateLongSeries, 'year', ['NDVI', 'MNDWI'])
  .setChartType('LineChart')
  .setOptions({
    title: 'NDVI and MNDWI — Candidate Pixel (2017–2025)',
    hAxis: { title: 'Year' },
    vAxis: { title: 'Index Value', viewWindow: { min: -1, max: 1 } },
    lineWidth: 2,
    pointSize: 6
  });
print(candidateLongChart);

// ============================================================
// অংশ L
// Persistent Patch-এর দীর্ঘমেয়াদি সূচকের ধারা
// ============================================================
// ------------------------------------------------------------
// 46. Persistent Patch-এর প্রতিবছরের গড় NDVI ও MNDWI
// ------------------------------------------------------------
var persistentLongSeries = ee.FeatureCollection(annualIndexCollection.map(function(image) {
  var stats = image
    .updateMask(persistentCandidate)
    .reduceRegion({
      reducer: ee.Reducer.mean(),
      geometry: aoi,
      scale: analysisScale,
      maxPixels: 1e9,
      tileScale: 4
    });
  return ee.Feature(null, stats)
    .set('year', image.get('year'))
    .set('image_count', image.get('image_count'));
}));
print('Persistent-candidate NDVI + MNDWI — 2017–2025:', persistentLongSeries);

// ------------------------------------------------------------
// 47. Persistent Patch-এর দীর্ঘমেয়াদি রেখাচিত্র
// ------------------------------------------------------------
var persistentLongChart = ui.Chart.feature.byFeature(persistentLongSeries, 'year', [
  'NDVI',
  'MNDWI'
])
  .setChartType('LineChart')
  .setOptions({
    title: 'Mean NDVI and MNDWI — Persistent Candidate Pixels (2017–2025)',
