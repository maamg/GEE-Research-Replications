// ============================================================
// প্রকল্প ০১ — নিঝুম দ্বীপ: বৃক্ষ-আচ্ছাদন হ্রাসের সম্ভাব্য কারণ বিশ্লেষণ
// মূল ফাইল: 04_Nijhum_Disturbance_Attribution.js
// বিশ্লেষণের ধরন: সম্ভাব্য বৃক্ষ-ক্ষয় (Candidate Disturbance) শনাক্ত ও ব্যাখ্যা
//
// গবেষণা এলাকা: নিঝুম দ্বীপ জাতীয় উদ্যান, বাংলাদেশ | SITE_ID: 317318
// ভিত্তিবর্ষ: ২০১৭ | পরিবর্তনের আগের তুলনাবর্ষ: ২০২৩ | পরবর্তী অবস্থা: ২০২৪–২০২৫ সালের গড়
// মূল লক্ষ্য: (১) ধারাবাহিক বৃক্ষ-হ্রাস   শনাক্ত; 
// (২) নির্দিষ্ট পিক্সেলে শ্রেণির Probability পর্যবেক্ষণ;
// (৩) ক্ষতিগ্রস্ত প্যাচের পরিবর্তনের ধারা; 
// (৪) trees কমলে কোন শ্রেণির Probability বাড়ে তা দেখা;
// (৫) সম্ভাব্য পরিবর্তনের শ্রেণিভিত্তিক মানচিত্র; 
// (৬) Sentinel-2 দিয়ে দৃশ্যগত যাচাই।
//

// সতর্কতা: এটি Ota-অনুপ্রাণিত অনুসন্ধানধর্মী বিশ্লেষণ; Li, Ota ও Mizoue-এর মূল
// Disturbance Attribution অ্যালগরিদমের হুবহু বাস্তবায়ন নয়।
// ============================================================
// ------------------------------------------------------------
// 1. AOI (গবেষণা এলাকার সীমানা) লোড
// ------------------------------------------------------------
// WDPA থেকে SITE_ID দিয়ে নিঝুম দ্বীপের সীমানা আলাদা করা হচ্ছে।
var wdpa = ee.FeatureCollection('WCMC/WDPA/current/polygons');
var nijhum = wdpa.filter(ee.Filter.eq('SITE_ID', 317318));
var aoi = nijhum.geometry();
Map.centerObject(aoi, 11);
Map.addLayer(nijhum, { color: 'yellow' }, 'Nijhum Dwip Boundary', false);
print('Nijhum Dwip:', nijhum);
print('Matched features:', nijhum.size());

// ------------------------------------------------------------
// 2. Dynamic World ডেটাসেট লোড ও সময়/এলাকা অনুযায়ী ফিল্টার
// ------------------------------------------------------------
// AOI, সময় এবং নভেম্বর–ডিসেম্বর বেছে নিয়ে মৌসুমি তুলনা সামঞ্জস্যপূর্ণ রাখা হচ্ছে।
var dw = ee.ImageCollection('GOOGLE/DYNAMICWORLD/V1')
  .filterBounds(aoi)
  .filterDate('2016-01-01', '2026-01-01')
  .filter(ee.Filter.calendarRange(11, 12, 'month'));
var probabilityBands = [
  'water',
  'trees',
  'grass',
  'flooded_vegetation',
  'crops',
  'shrub_and_scrub',
  'built',
  'bare',
  'snow_and_ice'
];
var dw9 = dw.select(probabilityBands);  // label band বাদ দিয়ে নতুন dw(dw9) তৈরি

// ------------------------------------------------------------
// 3. প্রতিবছরের ৯-ব্যান্ড Probability ImageCollection তৈরি
// ------------------------------------------------------------
// প্রতিটি বছরের নভেম্বর–ডিসেম্বরের Median নিয়ে একটি ৯-ব্যান্ড ইমেজ তৈরি হবে।
var years = ee.List.sequence(2016, 2025);
var annualDW9 = ee.ImageCollection.fromImages(years.map(function(year) {
  year = ee.Number(year);
  var start = ee.Date.fromYMD(year, 11, 1);
  var end = ee.Date.fromYMD(year.add(1), 1, 1);
  var yearlyDW = dw9.filterDate(start, end);
  var annualImage = yearlyDW.median().clip(aoi);
  return annualImage
    .set('year', year)
    .set('system:time_start', ee.Date.fromYMD(year, 12, 1).millis())
    .set('image_count', yearlyDW.size());
}));
print('Annual 9-band Dynamic World collection:', annualDW9);

// ------------------------------------------------------------
// 4. ২০১৭ সালের উচ্চ trees-Probability-কে Baseline ধরা
// ------------------------------------------------------------
// ২০১৭-এ trees Probability > 0.60 হলে Baseline Forest Pixel হিসেবে ধরা হচ্ছে।
var baselineYear = 2017;
var baselineImage = ee.Image(annualDW9.filter(ee.Filter.eq('year', baselineYear)).first());
var baselineTree = baselineImage.select('trees').rename('baseline_tree');
var baselineTreeThreshold = 0.60;
var baselineForestMask = baselineTree.gt(baselineTreeThreshold);
Map.addLayer(baselineForestMask.selfMask(), { palette: ['darkgreen'] }, '2017 High-Tree Baseline (>0.60)', false);

// ------------------------------------------------------------
// 5. ২০১৭-পরবর্তী বছরগুলোর trees-Probability হ্রাস নির্ণয়
// ------------------------------------------------------------
// হ্রাস = ২০১৭-এর trees Probability − সংশ্লিষ্ট বছরের trees Probability।
var post2017 = annualDW9.filter(ee.Filter.gt('year', baselineYear));   // 17 এর চেয়ে বড় সালের ইমেজগুরলো ফিল্টার করা

var annualDrops = post2017.map(function(image) {
  var year = ee.Number(image.get('year'));
  var currentTree = image.select('trees');
  var treeDrop = baselineTree.subtract(currentTree).rename('tree_drop');
  var yearBand = ee.Image.constant(year).rename('drop_year').toInt16();
  return image
    .addBands(treeDrop)
    .addBands(yearBand)
    .set('year', year)
    .copyProperties(image, ['system:time_start']);
});

// ------------------------------------------------------------
// 6. সবচেয়ে বেশি trees-Probability কমেছে কত ও কোন বছরে, তা বের করা
// ------------------------------------------------------------
// qualityMosaic() সর্বোচ্চ tree_drop-যুক্ত বছরের পিক্সেল ও বছর একসঙ্গে ধরে।
var maxDropComposite = annualDrops.qualityMosaic('tree_drop');
var maxTreeDrop = maxDropComposite.select('tree_drop').updateMask(baselineForestMask);
var maxDropYear = maxDropComposite.select('drop_year').updateMask(baselineForestMask);

// ------------------------------------------------------------
// 7. সম্ভাব্য, পুনরাবৃত্ত ও ধারাবাহিক বৃক্ষ-হ্রাসের Mask তৈরি
// ------------------------------------------------------------
var dropThreshold = 0.25;

// ------------------------------------------------------------
// 7A. অন্তত এক বছরে উল্লেখযোগ্য হ্রাস ঘটেছে এমন পিক্সেল
// ------------------------------------------------------------
var candidateDisturbance = baselineForestMask.and(maxTreeDrop.gt(dropThreshold));

// ------------------------------------------------------------
// 7B. কতটি বছরে উল্লেখযোগ্য হ্রাস হয়েছে, তা গণনা
// ------------------------------------------------------------
// প্রতিবছর dropThreshold পার করলে 1; পরে .sum() করে এমন বছরের সংখ্যা।
var declineFlags = annualDrops
  .map(function(image) {
    return image
      .select('tree_drop')
      .gt(dropThreshold)
      .rename('substantial_decline')
      .toByte()
      .set('year', image.get('year'));
  })
  .sort('year');
  
var declineYearCount = declineFlags
  .sum()
  .rename('decline_year_count')
  .updateMask(baselineForestMask);
  
Map.addLayer(declineYearCount);

// ------------------------------------------------------------
// 7C. যেকোনো দুটি বা বেশি বছরে হ্রাস পাওয়া পিক্সেল
// ------------------------------------------------------------
// অন্তত ২টি বছরে হ্রাস হলেই Repeated; বছর দুটি পরপর হওয়া বাধ্যতামূলক নয়।
// এটি আগের পদ্ধতির সঙ্গে তুলনার জন্য রাখা হয়েছে।
var repeatedCandidate = candidateDisturbance.and(declineYearCount.gte(2));

// ------------------------------------------------------------
// 7D. পরপর দুটি বছরে হ্রাস ঘটেছে কি না পরীক্ষা
// ------------------------------------------------------------
// পাশাপাশি দুই বছরের Boolean Mask-এর .and() দিয়ে ধারাবাহিকতা পরীক্ষা।
var declineList = declineFlags.toList(declineFlags.size());
var consecutivePairImages = ee.ImageCollection.fromImages(ee.List.sequence(0, declineFlags.size().subtract(2))
  .map(function(i) {
    i = ee.Number(i);
    var firstImage = ee.Image(declineList.get(i));
    var secondImage = ee.Image(declineList.get(i.add(1)));
    // দুটি পরপর বছরের হ্রাসই Threshold ছাড়ালে কেবল 1 পাওয়া যাবে।
    var consecutiveDecline = firstImage.and(secondImage).rename('consecutive_decline').toByte();
    return consecutiveDecline
      .set('start_year', firstImage.get('year'))
      .set('end_year', secondImage.get('year'));
  }));

// ------------------------------------------------------------
// 7E. প্রকৃত ধারাবাহিক হ্রাসের (Persistent) Mask
// ------------------------------------------------------------
// অন্তত এক জোড়া পরপর বছরে trees-হ্রাস Threshold-এর বেশি হলেই Persistent।
var persistentCandidate = consecutivePairImages
  .max()
  .eq(1)
  .and(baselineForestMask)
  .rename('persistent_candidate');

// ------------------------------------------------------------
// 7F. বিভিন্ন হ্রাসের Mask মানচিত্রে তুলনা
// ------------------------------------------------------------
Map.addLayer(repeatedCandidate
  .selfMask(), { palette: ['orange'] }, 'Repeated Decline (>=2 years, any years)', false);
Map.addLayer(persistentCandidate
  .selfMask(), { palette: ['magenta'] }, 'Persistent Decline (>=2 consecutive years)', true);

// ------------------------------------------------------------
// 8. অনুসন্ধানমূলক যাচাইয়ের জন্য একটি Candidate Point নির্বাচন
// ------------------------------------------------------------
// বেশি হ্রাস হওয়া নমুনা থেকে একটি পয়েন্ট নিয়ে বিশদভাবে দেখা হচ্ছে।
var candidateImage = maxTreeDrop
  .rename('max_tree_drop')
  .addBands(maxDropYear.rename('max_drop_year'))
  .addBands(declineYearCount)
  .updateMask(candidateDisturbance);
var candidateSamples = candidateImage.sample({
  region: aoi,
  scale: 10,
  numPixels: 100,
  seed: 42,
  geometries: true
});
var rankedCandidates = candidateSamples.sort('max_tree_drop', false);
var candidatePointFeature = ee.Feature(rankedCandidates.first());
var candidatePoint = candidatePointFeature.geometry();
Map.addLayer(candidatePoint, { color: 'cyan' }, 'Selected Candidate Point', true);
print('Selected candidate:', candidatePointFeature);

// ============================================================
// অংশ A
// নির্বাচিত পিক্সেলের পরিবর্তনের সম্ভাব্য কারণ
// ============================================================
// ------------------------------------------------------------
// 9. নির্বাচিত পিক্সেলে সময় অনুযায়ী সব গুরুত্বপূর্ণ Probability-এর রেখাচিত্র
// ------------------------------------------------------------
var candidateChart = ui.Chart.image.series({
  imageCollection: annualDW9.select([
    'trees',
    'water',
    'grass',
    'flooded_vegetation',
    'crops',
    'shrub_and_scrub',
    'built',
    'bare'
  ]),
  region: candidatePoint,
  reducer: ee.Reducer.mean(),
  scale: 10,
  xProperty: 'system:time_start'
})
  .setOptions({
    title: 'Dynamic World Probabilities — Candidate Disturbance Pixel',
    hAxis: { title: 'Year' },
    vAxis: { title: 'Probability', viewWindow: { min: 0, max: 1 } },
    lineWidth: 2,
    pointSize: 5
  });
print(candidateChart);

// ------------------------------------------------------------
// 10. Candidate Point-এর প্রতিবছরের Probability টেবিল
// ------------------------------------------------------------
// reduceRegion() দিয়ে নির্বাচিত পয়েন্টের প্রতিটি বছরের Probability পড়া হচ্ছে।
var candidateSeries = ee.FeatureCollection(annualDW9.map(function(image) {
  var values = image.reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: candidatePoint,
    scale: 10,
    bestEffort: true
  });
  return ee.Feature(null, {
    year: image.get('year'),
    trees: values.get('trees'),
    water: values.get('water'),
    grass: values.get('grass'),
    flooded_vegetation: values.get('flooded_vegetation'),
    crops: values.get('crops'),
    shrub_and_scrub: values.get('shrub_and_scrub'),
    built: values.get('built'),
    bare: values.get('bare')
  });
}));
print('Candidate annual probability table:', candidateSeries);

// ------------------------------------------------------------
// 11. ২০২৩, ২০২৪ ও ২০২৫ সালের পরিবর্তনে বিশেষ নজর
// ------------------------------------------------------------
var candidateRecent = candidateSeries.filter(ee.Filter.gte('year', 2023));
print('Candidate values — 2023 to 2025:', candidateRecent);

// ============================================================
// অংশ B
// ধারাবাহিক হ্রাসযুক্ত পুরো Patch-এর বিশ্লেষণ
// ============================================================
// ------------------------------------------------------------
// 12. Persistent Candidate পিক্সেলে বার্ষিক ইমেজ সীমাবদ্ধ করা
// ------------------------------------------------------------
var persistentAnnual = annualDW9.map(function(image) {
  return image.updateMask(persistentCandidate).copyProperties(image, ['year', 'system:time_start']);
});

// ------------------------------------------------------------
// 13. সব Persistent পিক্সেলের গড় Probability-র সময়ভিত্তিক ধারা
// ------------------------------------------------------------
// ------------------------------------------------------------
// পরিমার্জিত অংশ:
// Persistent Candidate পিক্সেলজুড়ে বার্ষিক গড় Probability-র ধারা
// ------------------------------------------------------------
var trajectoryBands = ['trees', 'water', 'flooded_vegetation', 'crops', 'shrub_and_scrub', 'bare'];
// সব Persistent পিক্সেলের গড় নিয়ে আলাদা বার্ষিক Feature তৈরি হচ্ছে।
var persistentSeries = ee.FeatureCollection(annualDW9.map(function(image) {
  var stats = image
    .select(trajectoryBands)
    .updateMask(persistentCandidate)
    .reduceRegion({
      reducer: ee.Reducer.mean(),
      geometry: aoi,
      scale: 10,
      maxPixels: 1e9,
      tileScale: 4
    });
  return ee.Feature(null, stats)
    .set('year', image.get('year'))
    .set('system:time_start', image.get('system:time_start'));
}));
print('Annual mean probabilities — persistent candidate pixels:', persistentSeries);
var persistentPatchChart = ui.Chart.feature.byFeature(persistentSeries, 'year', trajectoryBands)
  .setChartType('LineChart')
  .setOptions({
    title: 'Mean Probability Trajectory — Persistent Candidate Pixels',
    hAxis: { title: 'Year' },
    vAxis: { title: 'Mean Probability', viewWindow: { min: 0, max: 1 } },
    lineWidth: 2,
    pointSize: 5
  });
print(persistentPatchChart);

// ============================================================
// অংশ C
// পরিবর্তনের আগে ও পরের Probability তুলনা
// ============================================================
// ------------------------------------------------------------
// 14. ২০২৩–২০২৫ সালের আলাদা বার্ষিক ইমেজ সংগ্রহ
// ------------------------------------------------------------
var image2023 = ee.Image(annualDW9.filter(ee.Filter.eq('year', 2023)).first());
var image2024 = ee.Image(annualDW9.filter(ee.Filter.eq('year', 2024)).first());
var image2025 = ee.Image(annualDW9.filter(ee.Filter.eq('year', 2025)).first());

// ------------------------------------------------------------
// 15. পরিবর্তন-পরবর্তী (২০২৪–২০২৫) গড় ইমেজ তৈরি
// ------------------------------------------------------------
// শুধু ২০২৫ নয়; ২০২৪ ও ২০২৫-এর গড় নিয়ে স্থায়ী পরিবর্তনের প্রভাব দেখা হচ্ছে।
var postDisturbance = ee.ImageCollection.fromImages([image2024, image2025]).mean();

// ------------------------------------------------------------
// 16. trees-Probability পরিবর্তন = পরবর্তী গড় − ২০২৩
// ------------------------------------------------------------
// Positive ফল মানে trees Probability বেড়েছে, Negative মানে কমেছে।
var treeChange = postDisturbance
  .select('trees')
  .subtract(image2023.select('trees'))
  .rename('tree_change')
  .updateMask(persistentCandidate);
Map.addLayer(treeChange, {
  min: -0.60,
  max: 0.20,
  palette: ['darkred', 'red', 'orange', 'white', 'green']
}, 'Tree Change: 2023 → mean(2024-2025)', true);

// ------------------------------------------------------------
// 17. সম্ভাব্য নতুন ভূমি-আচ্ছাদন শ্রেণিগুলোর Probability পরিবর্তন
// ------------------------------------------------------------
// প্রতিটি Non-tree শ্রেণিতে পরের গড় থেকে ২০২৩-এর Probability বিয়োগ।
var attributionBands = [
  'water',
  'grass',
  'flooded_vegetation',
  'crops',
  'shrub_and_scrub',
  'built',
  'bare'
];
var classChanges = postDisturbance
  .select(attributionBands)
  .subtract(image2023.select(attributionBands))
  .updateMask(persistentCandidate);
print('Post-minus-pre class change image:', classChanges);

// ------------------------------------------------------------
// 18. Persistent এলাকায় শ্রেণিভিত্তিক গড় Probability পরিবর্তন
// ------------------------------------------------------------
// ধনাত্মক (+) মানে শ্রেণির Probability বেড়েছে; ঋণাত্মক (−) মানে কমেছে।
var meanClassChanges = classChanges.reduceRegion({
  reducer: ee.Reducer.mean(),
  geometry: aoi,
  scale: 10,
  maxPixels: 1e9
});
print('MEAN CLASS CHANGES across persistent candidates:', meanClassChanges);

// ------------------------------------------------------------
// 19. যেসব শ্রেণির Probability বেড়েছে, সেগুলোর মানচিত্র
// ------------------------------------------------------------
Map.addLayer(classChanges.select('water'), {
  min: -0.30,
  max: 0.30,
  palette: ['red', 'white', 'blue']
}, 'Water Change — Post vs 2023', false);
Map.addLayer(classChanges.select('flooded_vegetation'), {
  min: -0.30,
  max: 0.30,
  palette: ['red', 'white', 'green']
}, 'Flooded Vegetation Change — Post vs 2023', false);
Map.addLayer(classChanges.select('crops'), {
  min: -0.30,
  max: 0.30,
  palette: ['red', 'white', 'yellow']
}, 'Crops Change — Post vs 2023', false);
Map.addLayer(classChanges.select('shrub_and_scrub'), {
  min: -0.30,
  max: 0.30,
  palette: ['red', 'white', 'green']
}, 'Shrub/Scrub Change — Post vs 2023', false);
Map.addLayer(classChanges.select('bare'), {
  min: -0.30,
  max: 0.30,
  palette: ['green', 'white', 'brown']
}, 'Bare Change — Post vs 2023', false);

// ============================================================
// অংশ D
// যে শ্রেণি সবচেয়ে বেড়েছে, তার ভিত্তিতে সম্ভাব্য পরিবর্তন
// ============================================================
// ------------------------------------------------------------
// 20. কোন শ্রেণির Probability সবচেয়ে বেশি বেড়েছে, তা নির্ণয়
// ------------------------------------------------------------
// attributionBands-এর ক্রম: 0=water, 1=grass, 2=flooded_vegetation,
// 3=crops, 4=shrub_and_scrub, 5=built, 6=bare।
// মানচিত্রের শ্রেণি-কোডের সুবিধায় এগুলো পরে 1–7 করা হয়েছে।
// ------------------------------------------------------------
// সব শ্রেণির বৃদ্ধি তুলনা করে সবচেয়ে বেশি বেড়েছে যে শ্রেণি, তার Code রাখা।
var dominantGainCode = classChanges
  .toArray()
  .arrayArgmax()
  .arrayGet([0])
  .add(1)
  .rename('dominant_gain_class')
  .updateMask(persistentCandidate);
print('Dominant gain class codes:', '1=water, 2=grass, 3=flooded vegetation, ' +
  '4=crops, 5=shrub/scrub, 6=built, 7=bare');
Map.addLayer(dominantGainCode, {
  min: 1,
  max: 7,
  palette: [
    'blue', // 1 = জলাশয় (water)
    'lightgreen', // 2 = ঘাস (grass)
    'cyan', // 3 = প্লাবিত উদ্ভিদ
    'yellow', // 4 = ফসলি জমি
    'green', // 5 = ঝোপঝাড়
    'red', // 6 = নির্মিত এলাকা
    'brown' // 7 = অনাবৃত ভূমি
  ]
}, 'Dominant Probability Gain Class', true);

// ------------------------------------------------------------
// 21. নির্বাচিত Candidate Point-এর প্রধান বৃদ্ধি পাওয়া শ্রেণি
// ------------------------------------------------------------
var dominantAtPoint = dominantGainCode.reduceRegion({
  reducer: ee.Reducer.first(),
  geometry: candidatePoint,
  scale: 10,
  bestEffort: true
});
print('Dominant post-disturbance gain class at candidate point:', dominantAtPoint);

