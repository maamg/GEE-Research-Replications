// ------------------------------------------------------------
// Cloud Score+-এর সঙ্গে Link করে পরিষ্কার Sentinel-2 পর্যবেক্ষণ রাখা।
var s2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(aoi)
  .filterDate('2023-01-01', '2026-01-01');
var csPlus = ee.ImageCollection('GOOGLE/CLOUD_SCORE_PLUS/V1/S2_HARMONIZED');
// Cloud Score+ থেকে Sentinel-2-এর সঙ্গে মেঘমুক্ত মানের ব্যান্ড যুক্ত করা হচ্ছে।
var s2Linked = s2.linkCollection(csPlus, ['cs_cdf']);
// নিম্নমানের/মেঘযুক্ত পিক্সেল Mask করা হচ্ছে।
var s2Clean = s2Linked.map(function(image) {
