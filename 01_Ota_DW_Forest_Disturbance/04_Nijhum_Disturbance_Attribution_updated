// Lag অনুযায়ী শ্রেণি: ০ বছর = আকস্মিক; ১ বছর = দ্রুত;
// ২–৩ বছর = ক্রমশ; ৪+ বছর = দীর্ঘমেয়াদি ক্রমশ।
// এগুলো বিশ্লেষণের সুবিধার শ্রেণি; যাচাইকৃত Ecological Process নয়।
// ------------------------------------------------------------
// 75. পরিবর্তনের গতিভিত্তিক শ্রেণির Raster তৈরি
// ------------------------------------------------------------
//
// কোড: 1=আকস্মিক, 2=দ্রুত, 3=ক্রমশ, 4=দীর্ঘমেয়াদি ক্রমশ।
// ------------------------------------------------------------
// Lag অনুযায়ী ১–৪ Code বসিয়ে পরিবর্তনের গতি আলাদা করা হচ্ছে।
var processClass = ee.Image(0)
  .where(declineLagYears.eq(0), 1)
  .where(declineLagYears.eq(1), 2)
  .where(declineLagYears.gte(2)
    .and(declineLagYears.lte(3)), 3)
  .where(declineLagYears.gte(4), 4)
  .rename('process_class')
  .updateMask(persistentCandidate)
  .toInt8();
Map.addLayer(processClass, {
  min: 1,
  max: 4,
  palette: [
    'red', // আকস্মিক হ্রাস
    'orange', // দ্রুত হ্রাস
    'green', // ক্রমশ হ্রাস
    'blue' // দীর্ঘমেয়াদি ক্রমশ হ্রাস
  ]
}, 'Decline Process Class', false);

