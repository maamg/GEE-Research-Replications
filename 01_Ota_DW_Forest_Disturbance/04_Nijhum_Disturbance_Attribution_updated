// ============================================================
// ------------------------------------------------------------
// 32. Persistent Patch-জুড়ে সূচকের গড় হিসাবের ফাংশন
// ------------------------------------------------------------
// Persistent Mask-এর ভেতরে reduceRegion() দিয়ে Patch-এর গড় সূচক নির্ণয়।
var getPatchStats = function(image, year) {
  var stats = image
    .select(['NDVI', 'MNDWI'])
    .updateMask(persistentCandidate)
    .reduceRegion({
      reducer: ee.Reducer.mean(),
      geometry: aoi,
      scale: 10,
      maxPixels: 1e9,
      tileScale: 4
    });
  return ee.Feature(null, stats).set('year', year);
};

