// ============================================================
// PROJECT 01 — STEP 02
// Dynamic World probability preprocessing
// Study area: Madhupur National Park
// ============================================================

// ------------------------------------------------------------
// 1. LOAD AOI
// ------------------------------------------------------------


var wdpa = ee.FeatureCollection('WCMC/WDPA/current/polygons');

var madhupur = wdpa.filter(ee.Filter.eq('SITE_ID', 4481));

var aoi = madhupur.geometry();

Map.centerObject(aoi, 11);

// ------------------------------------------------------------
// 2. LOAD DYNAMIC WORLD
// ------------------------------------------------------------

var dw = ee.ImageCollection('GOOGLE/DYNAMICWORLD/V1')
  .filterBounds(aoi)
  .filterDate('2016-01-01', '2026-01-01')
  .filter(ee.Filter.calendarRange(11,12,'month'));
  
// ------------------------------------------------------------
//  3. CREATE functional probability groups
// -------------------------------------------------------------

var preprocessDw = function(image) {
  
  // Individual probabilities (generate single band image naming with band name)
  var trees = image.select('trees');
  var water = image.select('water');
  var built = image.select('built');
  var bare = image.select('bare');
  var snow = image.select('snow_and_ice');
  
  // Combine non-tree vegetation probabilities
  // (sum all non-tree vegetation-class probability bands into a single-band image named 'vegetation')
  var vegetation = image
    .select(['grass', 'flooded_vegetation', 'crops', 'shrub_and_scrub'])
    .reduce(ee.Reducer.sum())
    .rename('vegetation');
    
  // Combine into one image
  return ee.Image.cat([
    trees.rename('trees'),
    water.rename('water'),
    built.rename('built'),
    bare.rename('bare'),
    snow.rename('snow_and_ice'), 
    vegetation
    ])
  
  .copyProperties(image, ['system:time_start']); 
  
}

var dw6 =dw.map(preprocessDw);

print('Six functional probability bands: ', dw6.first());


// ------------------------------------------------------------
// 4. CHECK WHETHER PROBABILITIES STILL SUM TO ~1
// ------------------------------------------------------------

var firstImage = ee.Image(dw6.first());


var probabilitySum = firstImage
  .reduce(ee.Reducer.sum())
  .rename('probability_sum');


Map.addLayer( probabilitySum.clip(aoi), {min: 0.95, max: 1.05}, 'Probability Sum Check', false);


// ------------------------------------------------------------
// 5. INSPECT 2025 COMPOSITES
// ------------------------------------------------------------

var dw2025 = dw6.filterDate('2025-11-01', '2026-01-01');

// For learning/inspection only
var trees2025 = dw2025
  .select('trees')
  .median()
  .clip(aoi);
  
var vegetation2025 = dw2025
  .select('vegetation')
  .median()
  .clip(aoi);
  
  
// ------------------------------------------------------------
// 6. VISUALIZE
// ------------------------------------------------------------

Map.addLayer(trees2025, {min: 0, max: 1, palette: ['white', 'lightgreen', 'darkgreen']}, 'Trees Probability 2025');

Map.addLayer(vegetation2025, {min: 0, max: 1, palette: ['white', 'lightgreen', 'darkgreen']}, 'Vegetation Probability 2025');
































