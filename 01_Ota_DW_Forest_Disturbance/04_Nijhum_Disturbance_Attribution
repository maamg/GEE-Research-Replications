// ------------------------------------------------------------
// 42. CREATE ONE NOV-DEC COMPOSITE PER YEAR
// ------------------------------------------------------------
//
// Workflow:
//
// yearly Sentinel-2 observations
//        ↓
// cloud-quality masking
//        ↓
// median reflectance composite
//        ↓
// NDVI + MNDWI
//
// This follows the same logic used previously
// for the 2023–2025 verification.
// ------------------------------------------------------------

var annualIndexCollection =
  ee.ImageCollection.fromImages(

    indexYears.map(function(year) {

      year = ee.Number(year);


      var start =
        ee.Date.fromYMD(
          year,
          11,
          1
        );


      var end =
        ee.Date.fromYMD(
          year.add(1),
          1,
          1
        );


      var yearlyS2 =
        s2LongClean.filterDate(
          start,
          end
        );


      // Annual Nov-Dec median reflectance composite
      var annualComposite =
        yearlyS2
          .median()
          .clip(aoi);


      // Calculate NDVI + MNDWI
      var annualIndices =
        addLongIndices(
          annualComposite
        )
        .select([
          'NDVI',
          'MNDWI'
        ]);


      return annualIndices

        .set(
          'year',
          year
        )

        .set(
          'system:time_start',
          ee.Date.fromYMD(
            year,
            12,
            1
          ).millis()
        )

        .set(
          'image_count',
          yearlyS2.size()
        );

    })

  );


