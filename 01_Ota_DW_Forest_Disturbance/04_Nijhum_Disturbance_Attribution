// ============================================================
// PART J
// FULL NDVI + MNDWI TRAJECTORY: 2017–2025
// ============================================================
//
// PURPOSE:
//
// Verify whether the long-term decline in Dynamic World
// tree probability is also reflected in independent
// Sentinel-2 spectral indices.
//
// IMPORTANT:
//
// Sentinel-2 SR Harmonized begins in 2017.
// Therefore, this verification uses 2017–2025.
//
// ------------------------------------------------------------


// ------------------------------------------------------------
// 39. LOAD LONG-TERM SENTINEL-2 SR COLLECTION
// ------------------------------------------------------------

var s2Long = ee.ImageCollection(
    'COPERNICUS/S2_SR_HARMONIZED'
  )
  .filterBounds(aoi)
  .filterDate(
    '2017-01-01',
    '2026-01-01'
  );


var csPlusLong = ee.ImageCollection(
  'GOOGLE/CLOUD_SCORE_PLUS/V1/S2_HARMONIZED'
);


// Link Cloud Score+ quality band
var s2LongLinked =
  s2Long.linkCollection(
    csPlusLong,
    ['cs_cdf']
  );


// Cloud / poor-quality pixel masking
var s2LongClean =
  s2LongLinked.map(function(image) {

    return image.updateMask(

      image
        .select('cs_cdf')
        .gte(0.60)

    );

  });


// ------------------------------------------------------------
// 40. FUNCTION TO ADD NDVI + MNDWI
// ------------------------------------------------------------

var addLongIndices = function(image) {

  var ndvi = image
    .normalizedDifference([
      'B8',
      'B4'
    ])
    .rename('NDVI');


  var mndwi = image
    .normalizedDifference([
      'B3',
      'B11'
    ])
    .rename('MNDWI');


  return image
    .addBands(ndvi)
    .addBands(mndwi);

};


