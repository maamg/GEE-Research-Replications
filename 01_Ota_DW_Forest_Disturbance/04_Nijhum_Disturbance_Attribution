// ------------------------------------------------------------
// 65. CREATE FIRST-DECLINE-YEAR IMAGE COLLECTION
// ------------------------------------------------------------

var firstDeclineYearCollection =
  annualDrops.map(function(image) {

    var year =
      ee.Number(
        image.get('year')
      );


    var substantialDecline =
      image
        .select('tree_drop')
        .gt(dropThreshold);


    // Create a constant image containing the year.
    // Explicitly cast every year's image to Int16
    // so all images have the same band data type.
    var yearImage =
      ee.Image.constant(year)

        .rename(
          'first_decline_year'
        )

        .toInt16()

        .updateMask(
          substantialDecline
        )

        .updateMask(
          persistentCandidate
        );


    return yearImage;

  });


// ------------------------------------------------------------
// 66. FIND EARLIEST THRESHOLD-CROSSING YEAR
// ------------------------------------------------------------
//
// Since years are numeric:
//
// min(2018, 2019, 2020 ...)
// = earliest year that remained unmasked.
//
// ------------------------------------------------------------

var firstDeclineYear =
  firstDeclineYearCollection
    .min()
    .rename(
      'first_decline_year'
    );


Map.addLayer(

  firstDeclineYear,

