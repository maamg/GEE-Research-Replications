// ============================================================
// PART R — OPTIMIZED
// FIRST-DECLINE YEAR × MAXIMUM-DROP YEAR TRANSITION MATRIX
// ============================================================
//
// This optimized version uses ONE grouped aggregation
// instead of 64 separate reduceRegion() calls.
//
// transition code example:
//
// first decline = 2021
// maximum drop  = 2025
//
// code = 2021 * 10000 + 2025
//      = 20212025
//
// ============================================================


// ------------------------------------------------------------
// 77. CREATE TRANSITION-CODE IMAGE
// ------------------------------------------------------------

var transitionCode =

  firstDeclineYear
    .toInt32()
    .multiply(10000)

    .add(
      maxDropYear.toInt32()
    )

    .rename(
      'transition_code'
    )

    .updateMask(
      persistentCandidate
    );


// ------------------------------------------------------------
// 78. COMBINE PIXEL AREA + TRANSITION CODE
// ------------------------------------------------------------

var transitionAreaImage =

  pixelAreaHa
    .addBands(
      transitionCode
    );


// ------------------------------------------------------------
// 79. ONE GROUPED AREA REDUCTION
// ------------------------------------------------------------
//
// Band 0 = area_ha
// Band 1 = transition_code
//
// groupField: 1 means:
// group area sums according to transition_code.
//
// ------------------------------------------------------------

var transitionGroupedResult =

  transitionAreaImage.reduceRegion({

    reducer:

      ee.Reducer
        .sum()

        .group({

          groupField:
            1,

          groupName:
            'transition_code'

        }),

    geometry:
      aoi,

    scale:
      10,

    maxPixels:
      1e9,

    tileScale:
      4

  });


// ------------------------------------------------------------
// 80. CONVERT GROUPED RESULT TO FEATURE COLLECTION
// ------------------------------------------------------------

var transitionGroups =

  ee.List(
    transitionGroupedResult.get(
      'groups'
    )
  );


var transitionSummary =

  ee.FeatureCollection(

    transitionGroups.map(
      function(item) {

        item =
          ee.Dictionary(item);


        var code =
          ee.Number(
            item.get(
              'transition_code'
            )
          )
          .toInt();


        // Recover first-decline year
        var firstYear =

          code
            .divide(10000)
            .floor()
            .toInt();


        // Recover maximum-drop year
        var maxYear =

          code
            .mod(10000)
            .toInt();


        var areaHa =

          ee.Number(
            item.get('sum')
          );


        var lagYears =

          maxYear.subtract(
            firstYear
          );


        var percentage =

          areaHa
            .divide(
              persistentDeclineAreaHa
            )
            .multiply(100);


        return ee.Feature(
          null,
          {

            first_decline_year:
              firstYear,

            max_drop_year:
              maxYear,

            lag_years:
              lagYears,

            area_ha:
              areaHa,

            pct_of_persistent_area:
              percentage

          }
        );

      }
    )

  );


