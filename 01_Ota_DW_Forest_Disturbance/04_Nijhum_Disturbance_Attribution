// ------------------------------------------------------------

var processClass =
  ee.Image(0)

    .where(
      declineLagYears.eq(0),
      1
    )

    .where(
      declineLagYears.eq(1),
      2
    )

    .where(
      declineLagYears.gte(2)
        .and(
          declineLagYears.lte(3)
        ),
      3
    )

    .where(
      declineLagYears.gte(4),
      4
    )

    .rename(
      'process_class'
    )

    .updateMask(
      persistentCandidate
    )

    .toInt8();


Map.addLayer(

  processClass,

  {
    min: 1,
    max: 4,

    palette: [
      'red',      // abrupt
      'orange',   // rapid
      'green',    // progressive
      'blue'      // prolonged progressive
    ]
  },

  'Decline Process Class',

  false
);


// ------------------------------------------------------------
// 76. PROCESS CLASS SUMMARY
// ------------------------------------------------------------

var processCodes =
  ee.List.sequence(
    1,
    4
  );


// Labels correspond to:
// 1 = Abrupt
// 2 = Rapid
// 3 = Progressive
// 4 = Prolonged progressive

var processLabels =
  ee.List([
    'Abrupt',
    'Rapid',
    'Progressive',
    'Prolonged progressive'
  ]);


var processSummary =
  ee.FeatureCollection(

    processCodes.map(function(code) {

      // Convert explicitly to integer
      code = ee.Number(code).toInt();


      var classMask =
        processClass.eq(
          code
        );


      var areaDict =
        pixelAreaHa

          .updateMask(
            classMask
          )

          .reduceRegion({

            reducer:
              ee.Reducer.sum(),

            geometry:
              aoi,

            scale:
              10,

            maxPixels:
              1e9,

            tileScale:
              4

          });


      var areaHa =
        ee.Number(

          ee.Algorithms.If(

            areaDict.contains(
              'area_ha'
            ),

            areaDict.get(
              'area_ha'
            ),

            0

          )

        );


      var percentage =
        areaHa

          .divide(
            persistentDeclineAreaHa
          )

          .multiply(100);


      // code 1 → index 0
      // code 2 → index 1
      // code 3 → index 2
      // code 4 → index 3

      var label =
        processLabels.get(
          code.subtract(1)
        );


      return ee.Feature(
        null,
        {

          process_code:
            code,

          process:
            label,

          area_ha:
            areaHa,

          pct_of_persistent_area:
            percentage

        }
      );

    })

  );


print(
