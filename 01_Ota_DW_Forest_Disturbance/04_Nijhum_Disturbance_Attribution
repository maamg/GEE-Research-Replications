// ============================================================
// PART N
// YEAR-OF-MAXIMUM-TREE-DROP SUMMARY
// ============================================================
//
// PURPOSE:
//
// For every persistent candidate pixel:
//
// 2018 ... 2025
//      ↓
// Which year had the largest decline
// from the 2017 tree-probability baseline?
//
// Then calculate how many hectares belong
// to each maximum-decline year.
//
// IMPORTANT:
//
// This is "year of MAXIMUM decline".
//
// It is NOT necessarily the first year
// when disturbance began.
// ============================================================


// ------------------------------------------------------------
// 59. CREATE POST-BASELINE YEAR LIST
// ------------------------------------------------------------

var changeYears = ee.List.sequence(
  2018,
  2025
);


// ------------------------------------------------------------
// 60. CALCULATE AREA BY YEAR OF MAXIMUM TREE DROP
// ------------------------------------------------------------

var yearOfMaxDropSummary =
  ee.FeatureCollection(

    changeYears.map(function(year) {

      year = ee.Number(year);


      // Pixels whose strongest decline occurred
      // in this specific year.
      var yearMask =
        maxDropYear
          .eq(year)

          // Keep only persistent tree-decline candidates.
          .and(
            persistentCandidate
          );


      // Calculate area in hectares.
      var areaDict =
        pixelAreaHa

          .updateMask(
            yearMask
          )

          .reduceRegion({

            reducer:
              ee.Reducer.sum(),

            geometry:
              aoi,

            scale:
              10,

            maxPixels:
              1e9,

            tileScale:
              4

          });


      // If no pixel belongs to a year,
      // return 0 instead of null.
      var areaHa =
        ee.Number(
          ee.Algorithms.If(
            areaDict.contains('area_ha'),
            areaDict.get('area_ha'),
            0
          )
        );


      // Percentage of total persistent
      // candidate area.
      var percentPersistent =
        areaHa

          .divide(
            persistentDeclineAreaHa
          )

          .multiply(100);


      return ee.Feature(
        null,
        {

          year:
            year,

          area_ha:
            areaHa,

          pct_of_persistent_area:
            percentPersistent

        }
      );

    })

  );


print(
  'YEAR OF MAXIMUM TREE DROP — AREA SUMMARY:',
  yearOfMaxDropSummary
);


