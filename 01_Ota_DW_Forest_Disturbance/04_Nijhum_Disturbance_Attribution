// ============================================================
// PROJECT 01 — NIJHUM DWIP
// FILE: 04_Nijhum_Disturbance_Attribution.js
//
// Candidate Disturbance Attribution
//
// Study area: Nijhum Dwip National Park, Bangladesh
// SITE_ID: 317318
//
// Baseline forest year: 2017
// Pre-disturbance reference: 2023
// Post-disturbance condition: mean of 2024 and 2025
//
// PURPOSE:
// 1. Reconstruct persistent tree-decline candidates.
// 2. Examine all Dynamic World probabilities at a candidate pixel.
// 3. Examine mean trajectories across persistent candidate patches.
// 4. Determine which non-tree probabilities increased when
//    tree probability declined.
// 5. Produce an exploratory transition-attribution map.
// 6. Visually compare Sentinel-2 imagery before and after decline.
//
// IMPORTANT:
// This is an exploratory Ota-inspired attribution analysis.
// It is NOT yet the exact disturbance-attribution algorithm
// of Li, Ota & Mizoue.
// ============================================================


// ------------------------------------------------------------
// 1. LOAD AOI
// ------------------------------------------------------------

var wdpa = ee.FeatureCollection(
  'WCMC/WDPA/current/polygons'
);

var nijhum = wdpa.filter(
  ee.Filter.eq('SITE_ID', 317318)
);

var aoi = nijhum.geometry();

Map.centerObject(aoi, 11);

Map.addLayer(
  nijhum,
  {color: 'yellow'},
  'Nijhum Dwip Boundary',
  false
);

print('Nijhum Dwip:', nijhum);
print('Matched features:', nijhum.size());


// ------------------------------------------------------------
// 2. LOAD DYNAMIC WORLD
// ------------------------------------------------------------

var dw = ee.ImageCollection(
    'GOOGLE/DYNAMICWORLD/V1'
  )
  .filterBounds(aoi)
  .filterDate('2016-01-01', '2026-01-01')
  .filter(
    ee.Filter.calendarRange(
      11,
      12,
      'month'
    )
  );


var probabilityBands = [
  'water',
  'trees',
  'grass',
  'flooded_vegetation',
  'crops',
  'shrub_and_scrub',
  'built',
  'bare',
  'snow_and_ice'
];


var dw9 = dw.select(
  probabilityBands
);


// ------------------------------------------------------------
// 3. CREATE ANNUAL 9-BAND PROBABILITY COLLECTION
// ------------------------------------------------------------

var years = ee.List.sequence(
  2016,
  2025
);


var annualDW9 = ee.ImageCollection.fromImages(

  years.map(function(year) {

    year = ee.Number(year);

    var start = ee.Date.fromYMD(
      year,
      11,
      1
    );

    var end = ee.Date.fromYMD(
      year.add(1),
      1,
      1
    );

    var yearlyDW = dw9.filterDate(
      start,
      end
    );

    var annualImage = yearlyDW
      .median()
      .clip(aoi);

    return annualImage

      .set(
        'year',
        year
      )

      .set(
        'system:time_start',
        ee.Date.fromYMD(
          year,
          12,
          1
        ).millis()
      )

      .set(
        'image_count',
        yearlyDW.size()
      );

  })

);


print(
  'Annual 9-band Dynamic World collection:',
  annualDW9
);


// ------------------------------------------------------------
// 4. RECONSTRUCT 2017 HIGH-TREE BASELINE
// ------------------------------------------------------------

var baselineYear = 2017;

var baselineImage = ee.Image(

  annualDW9
    .filter(
      ee.Filter.eq(
        'year',
        baselineYear
      )
    )
    .first()

);


var baselineTree = baselineImage
  .select('trees')
  .rename('baseline_tree');


var baselineTreeThreshold = 0.60;


var baselineForestMask =
  baselineTree.gt(
    baselineTreeThreshold
  );


Map.addLayer(

  baselineForestMask.selfMask(),

  {palette: ['darkgreen']},

  '2017 High-Tree Baseline (>0.60)',

  false
);


// ------------------------------------------------------------
// 5. CREATE POST-2017 TREE-DROP COLLECTION
// ------------------------------------------------------------

var post2017 = annualDW9.filter(
  ee.Filter.gt(
    'year',
    baselineYear
  )
);


var annualDrops =
  post2017.map(function(image) {

    var year = ee.Number(
      image.get('year')
    );

    var currentTree =
      image.select('trees');

    var treeDrop =
      baselineTree
        .subtract(currentTree)
        .rename('tree_drop');

    var yearBand =
      ee.Image.constant(year)
        .rename('drop_year')
        .toInt16();

    return image

      .addBands(treeDrop)

      .addBands(yearBand)

      .set(
        'year',
        year
      )

      .copyProperties(
        image,
        ['system:time_start']
      );

  });


// ------------------------------------------------------------
// 6. FIND MAXIMUM TREE DROP
// ------------------------------------------------------------

var maxDropComposite =
  annualDrops.qualityMosaic(
    'tree_drop'
  );


var maxTreeDrop =
  maxDropComposite
    .select('tree_drop')
    .updateMask(
      baselineForestMask
    );


var maxDropYear =
  maxDropComposite
    .select('drop_year')
    .updateMask(
      baselineForestMask
    );


// ------------------------------------------------------------
// 7. CANDIDATE + REPEATED DECLINE MASKS
// ------------------------------------------------------------

var dropThreshold = 0.25;


var candidateDisturbance =
  baselineForestMask.and(

    maxTreeDrop.gt(
      dropThreshold
    )

  );


var declineYearCount =
  annualDrops

    .map(function(image) {

      return image
        .select('tree_drop')
        .gt(dropThreshold)
        .rename('large_decline');

    })

    .sum()

    .rename(
      'decline_year_count'
    )

    .updateMask(
      baselineForestMask
    );


var persistentCandidate =
  candidateDisturbance.and(

    declineYearCount.gte(2)

  );


Map.addLayer(

  candidateDisturbance
    .selfMask(),

  {palette: ['red']},

  'Candidate Tree Disturbance',

  false
);


Map.addLayer(

  persistentCandidate
    .selfMask(),

  {palette: ['magenta']},

  'Persistent Candidate (>=2 years)',

  true
);


// ------------------------------------------------------------
// 8. RECREATE SELECTED EXPLORATORY CANDIDATE POINT
// ------------------------------------------------------------

var candidateImage =
  maxTreeDrop
    .rename('max_tree_drop')

    .addBands(
      maxDropYear.rename(
        'max_drop_year'
      )
    )

    .addBands(
      declineYearCount
    )

    .updateMask(
      candidateDisturbance
    );


var candidateSamples =
  candidateImage.sample({

    region: aoi,

    scale: 10,

    numPixels: 100,

    seed: 42,

    geometries: true

  });


var rankedCandidates =
  candidateSamples.sort(
    'max_tree_drop',
    false
  );


var candidatePointFeature =
  ee.Feature(
    rankedCandidates.first()
  );


var candidatePoint =
  candidatePointFeature.geometry();


Map.addLayer(

  candidatePoint,

  {color: 'cyan'},

  'Selected Candidate Point',

  true
);


print(
  'Selected candidate:',
  candidatePointFeature
);


// ============================================================
// PART A
// CANDIDATE-POINT ATTRIBUTION
// ============================================================


// ------------------------------------------------------------
// 9. ALL IMPORTANT PROBABILITIES THROUGH TIME
// ------------------------------------------------------------

var candidateChart =
  ui.Chart.image.series({

    imageCollection:
      annualDW9.select([

        'trees',
        'water',
        'grass',
        'flooded_vegetation',
        'crops',
        'shrub_and_scrub',
        'built',
        'bare'

      ]),

    region:
      candidatePoint,

    reducer:
      ee.Reducer.mean(),

    scale:
      10,

    xProperty:
      'system:time_start'

  })


  .setOptions({

    title:
      'Dynamic World Probabilities — Candidate Disturbance Pixel',

    hAxis: {
      title: 'Year'
    },

    vAxis: {

      title: 'Probability',

      viewWindow: {
        min: 0,
        max: 1
      }

    },

    lineWidth: 2,

    pointSize: 5

  });


print(candidateChart);


// ------------------------------------------------------------
// 10. PRINT YEAR-BY-YEAR CANDIDATE VALUES
// ------------------------------------------------------------

var candidateSeries =
  ee.FeatureCollection(

    annualDW9.map(function(image) {

      var values =
        image.reduceRegion({

          reducer:
            ee.Reducer.mean(),

          geometry:
            candidatePoint,

          scale:
            10,

          bestEffort:
            true

        });


      return ee.Feature(
        null,
        {

          year:
            image.get('year'),

          trees:
            values.get('trees'),

          water:
            values.get('water'),

          grass:
            values.get('grass'),

          flooded_vegetation:
            values.get(
              'flooded_vegetation'
            ),

          crops:
            values.get('crops'),

          shrub_and_scrub:
            values.get(
              'shrub_and_scrub'
            ),

          built:
            values.get('built'),

          bare:
            values.get('bare')

        }
      );

    })

  );


print(
  'Candidate annual probability table:',
  candidateSeries
);


// ------------------------------------------------------------
// 11. FOCUS ON 2023, 2024 AND 2025
// ------------------------------------------------------------

var candidateRecent =
  candidateSeries.filter(

    ee.Filter.gte(
      'year',
      2023
    )

  );


print(
  'Candidate values — 2023 to 2025:',
  candidateRecent
);


// ============================================================
// PART B
// PERSISTENT-CANDIDATE PATCH ANALYSIS
// ============================================================


// ------------------------------------------------------------
// 12. MASK ANNUAL IMAGES TO PERSISTENT CANDIDATES
// ------------------------------------------------------------

var persistentAnnual =
  annualDW9.map(function(image) {

    return image
      .updateMask(
        persistentCandidate
      )
      .copyProperties(
        image,
        [
          'year',
          'system:time_start'
        ]
      );

  });


// ------------------------------------------------------------
// 13. MEAN TRAJECTORY ACROSS ALL PERSISTENT PIXELS
// ------------------------------------------------------------

// ------------------------------------------------------------
// REPLACEMENT:
// MEAN TRAJECTORY ACROSS PERSISTENT CANDIDATE PIXELS
// ------------------------------------------------------------

var trajectoryBands = [
  'trees',
  'water',
  'flooded_vegetation',
  'crops',
  'shrub_and_scrub',
  'bare'
];


var persistentSeries = ee.FeatureCollection(

  annualDW9.map(function(image) {

    var stats = image

      .select(trajectoryBands)

      .updateMask(
        persistentCandidate
      )

      .reduceRegion({

        reducer:
          ee.Reducer.mean(),

        geometry:
          aoi,

        scale:
          10,

        maxPixels:
          1e9,

        tileScale:
          4

      });


    return ee.Feature(
      null,
      stats
    )

    .set(
      'year',
      image.get('year')
    )

    .set(
      'system:time_start',
      image.get('system:time_start')
    );

  })

);


print(
  'Annual mean probabilities — persistent candidate pixels:',
  persistentSeries
);


var persistentPatchChart =
  ui.Chart.feature.byFeature(

    persistentSeries,

    'year',

    trajectoryBands

  )

  .setChartType(
    'LineChart'
  )

  .setOptions({

    title:
      'Mean Probability Trajectory — Persistent Candidate Pixels',

    hAxis: {
      title: 'Year'
    },

    vAxis: {

      title:
        'Mean Probability',

      viewWindow: {
        min: 0,
        max: 1
      }

    },

    lineWidth:
      2,

    pointSize:
      5

  });


print(
  persistentPatchChart
);


// ============================================================
// PART C
// PRE- VS POST-DISTURBANCE COMPARISON
// ============================================================


// ------------------------------------------------------------
// 14. GET 2023, 2024, 2025 ANNUAL IMAGES
// ------------------------------------------------------------

var image2023 = ee.Image(

  annualDW9
    .filter(
      ee.Filter.eq(
        'year',
        2023
      )
    )
    .first()

);


var image2024 = ee.Image(

  annualDW9
    .filter(
      ee.Filter.eq(
        'year',
        2024
      )
    )
    .first()

);


var image2025 = ee.Image(

  annualDW9
    .filter(
      ee.Filter.eq(
        'year',
        2025
      )
    )
    .first()

);


// ------------------------------------------------------------
// 15. CREATE POST-DISTURBANCE MEAN
// ------------------------------------------------------------
//
// Instead of relying only on 2025,
// average 2024 and 2025.
//
// This gives more emphasis to persistent change.
//

var postDisturbance =
  ee.ImageCollection.fromImages([

    image2024,

    image2025

  ])

  .mean();


// ------------------------------------------------------------
// 16. TREE CHANGE: POST - 2023
// ------------------------------------------------------------

var treeChange =
  postDisturbance
    .select('trees')

    .subtract(
      image2023.select('trees')
    )

    .rename(
      'tree_change'
    )

    .updateMask(
      persistentCandidate
    );


Map.addLayer(

  treeChange,

  {

    min: -0.60,

    max: 0.20,

    palette: [
      'darkred',
      'red',
      'orange',
      'white',
      'green'
    ]

  },

  'Tree Change: 2023 → mean(2024-2025)',

  true
);


// ------------------------------------------------------------
// 17. CALCULATE CHANGES IN POSSIBLE ATTRIBUTION CLASSES
// ------------------------------------------------------------

var attributionBands = [

  'water',

  'grass',

  'flooded_vegetation',

  'crops',

  'shrub_and_scrub',

  'built',

  'bare'

];


var classChanges =
  postDisturbance

    .select(
      attributionBands
    )

    .subtract(
      image2023.select(
        attributionBands
      )
    )

    .updateMask(
      persistentCandidate
    );


print(
  'Post-minus-pre class change image:',
  classChanges
);


// ------------------------------------------------------------
// 18. MEAN CLASS CHANGES ACROSS PERSISTENT PIXELS
// ------------------------------------------------------------
//
// Positive = class probability increased.
//
// Negative = class probability decreased.
//

var meanClassChanges =
  classChanges.reduceRegion({

    reducer:
      ee.Reducer.mean(),

    geometry:
      aoi,

    scale:
      10,

    maxPixels:
      1e9

  });


print(
  'MEAN CLASS CHANGES across persistent candidates:',
  meanClassChanges
);


// ------------------------------------------------------------
// 19. VISUALIZE INDIVIDUAL CLASS GAINS
// ------------------------------------------------------------

Map.addLayer(

  classChanges.select('water'),

  {

    min: -0.30,

    max: 0.30,

    palette: [
      'red',
      'white',
      'blue'
    ]

  },

  'Water Change — Post vs 2023',

  false
);


Map.addLayer(

  classChanges.select(
    'flooded_vegetation'
  ),

  {

    min: -0.30,

    max: 0.30,

    palette: [
      'red',
      'white',
      'green'
    ]

  },

  'Flooded Vegetation Change — Post vs 2023',

  false
);


Map.addLayer(

  classChanges.select('crops'),

  {

    min: -0.30,

    max: 0.30,

    palette: [
      'red',
      'white',
      'yellow'
    ]

  },

  'Crops Change — Post vs 2023',

  false
);


Map.addLayer(

  classChanges.select(
    'shrub_and_scrub'
  ),

  {

    min: -0.30,

    max: 0.30,

    palette: [
      'red',
      'white',
      'green'
    ]

  },

  'Shrub/Scrub Change — Post vs 2023',

  false
);


Map.addLayer(

  classChanges.select('bare'),

  {

    min: -0.30,

    max: 0.30,

    palette: [
      'green',
      'white',
      'brown'
    ]

  },

  'Bare Change — Post vs 2023',

  false
);


// ============================================================
// PART D
// EXPLORATORY DOMINANT-TRANSITION ATTRIBUTION
// ============================================================


// ------------------------------------------------------------
// 20. FIND CLASS WITH LARGEST PROBABILITY INCREASE
// ------------------------------------------------------------
//
// attributionBands order:
//
// 0 = water
// 1 = grass
// 2 = flooded_vegetation
// 3 = crops
// 4 = shrub_and_scrub
// 5 = built
// 6 = bare
//
// We convert to codes 1–7 below.
// ------------------------------------------------------------

var dominantGainCode =
  classChanges

    .toArray()

    .arrayArgmax()

    .arrayGet([0])

    .add(1)

    .rename(
      'dominant_gain_class'
    )

    .updateMask(
      persistentCandidate
    );


print(
  'Dominant gain class codes:',
  '1=water, 2=grass, 3=flooded vegetation, ' +
  '4=crops, 5=shrub/scrub, 6=built, 7=bare'
);


Map.addLayer(

  dominantGainCode,

  {

    min: 1,

    max: 7,

    palette: [
      'blue',       // 1 water
      'lightgreen', // 2 grass
      'cyan',       // 3 flooded vegetation
      'yellow',     // 4 crops
      'green',      // 5 shrub/scrub
      'red',        // 6 built
      'brown'       // 7 bare
    ]

  },

  'Dominant Probability Gain Class',

  true
);


// ------------------------------------------------------------
// 21. DOMINANT GAIN CLASS AT SELECTED CANDIDATE POINT
// ------------------------------------------------------------

var dominantAtPoint =
  dominantGainCode.reduceRegion({

    reducer:
      ee.Reducer.first(),

    geometry:
      candidatePoint,

    scale:
      10,

    bestEffort:
      true

  });


print(
  'Dominant post-disturbance gain class at candidate point:',
  dominantAtPoint
);


// ============================================================
// PART E
// SENTINEL-2 VISUAL CHECK
// ============================================================


// ------------------------------------------------------------
// 22. LOAD SENTINEL-2 + CLOUD SCORE+
// ------------------------------------------------------------

var s2 = ee.ImageCollection(
    'COPERNICUS/S2_SR_HARMONIZED'
  )
  .filterBounds(aoi)
  .filterDate(
    '2023-01-01',
    '2026-01-01'
  );


var csPlus = ee.ImageCollection(
  'GOOGLE/CLOUD_SCORE_PLUS/V1/S2_HARMONIZED'
);


// Link cloud-quality score to Sentinel-2 images.
var s2Linked =
  s2.linkCollection(
    csPlus,
    ['cs_cdf']
  );


// Mask lower-quality observations.
var s2Clean =
  s2Linked.map(function(image) {

    return image
      .updateMask(
        image
          .select('cs_cdf')
          .gte(0.60)
      );

  });


// ------------------------------------------------------------
// 23. CREATE NOV-DEC SENTINEL-2 COMPOSITES
// ------------------------------------------------------------

var getS2Composite =
  function(year) {

    var start =
      ee.Date.fromYMD(
        year,
        11,
        1
      );

    var end =
      ee.Date.fromYMD(
        year + 1,
        1,
        1
      );

    return s2Clean

      .filterDate(
        start,
        end
      )

      .median()

      .clip(aoi);

  };


var s2_2023 =
  getS2Composite(2023);


var s2_2024 =
  getS2Composite(2024);


var s2_2025 =
  getS2Composite(2025);


// ------------------------------------------------------------
// 24. TRUE-COLOR VISUALIZATION
// ------------------------------------------------------------

var trueColor = {

  bands: [
    'B4',
    'B3',
    'B2'
  ],

  min: 0,

  max: 3000

};


Map.addLayer(

  s2_2023,

  trueColor,

  'Sentinel-2 True Color — Nov-Dec 2023',

  false
);


Map.addLayer(

  s2_2024,

  trueColor,

  'Sentinel-2 True Color — Nov-Dec 2024',

  false
);


Map.addLayer(

  s2_2025,

  trueColor,

  'Sentinel-2 True Color — Nov-Dec 2025',

  false
);


// ------------------------------------------------------------
// 25. FALSE-COLOR VEGETATION VISUALIZATION
// ------------------------------------------------------------

var falseColor = {

  bands: [
    'B8',
    'B4',
    'B3'
  ],

  min: 0,

  max: 4000

};


Map.addLayer(

  s2_2023,

  falseColor,

  'Sentinel-2 False Color — 2023',

  false
);


Map.addLayer(

  s2_2024,

  falseColor,

  'Sentinel-2 False Color — 2024',

  false
);


Map.addLayer(

  s2_2025,

  falseColor,

  'Sentinel-2 False Color — 2025',

  false
);


// ============================================================
// INTERPRETATION GUIDE
// ============================================================
//
// STEP 1
// ------
// Confirm that tree probability declines strongly in
// 2024 and 2025 at the selected candidate.
//
//
//
// STEP 2
// ------
// Examine which classes increase:
//
// tree ↓ + water ↑
// → possible inundation / erosion / water transition
//
// tree ↓ + bare ↑
// → possible exposed surface / erosion / clearing
//
// tree ↓ + crops ↑
// → possible conversion to agricultural-like cover
//
// tree ↓ + shrub/scrub ↑
// → possible degradation / canopy opening / succession
//
// tree ↓ + flooded vegetation ↑
// → possible wetland / inundated vegetation transition
//
//
//
// STEP 3
// ------
// Check whether the same relationship occurs across
// the persistent candidate patches, not just one pixel.
//
//
//
// STEP 4
// ------
// Compare Sentinel-2 imagery:
//
// 2023 = pre-decline condition
// 2024 = first strong decline year
// 2025 = persistent / stronger decline
//
//
//
// IMPORTANT
// ---------
// The "dominant gain class" is an exploratory
// attribution indicator.
//
// It does NOT by itself prove:
// erosion,
// deforestation,
// agricultural conversion,
// flooding,
// or degradation.
//
// Final interpretation requires:
// spatial consistency,
// temporal persistence,
// Sentinel-2 visual evidence,
// and preferably external/reference information.
// ============================================================

// ============================================================
// PART F
// NDVI + MNDWI VERIFICATION
// ============================================================
//
// PURPOSE:
//
// NDVI  = vegetation greenness / vigor
// MNDWI = surface-water / wetness-related signal
//
// We test whether the Dynamic World tree-probability decline
// is supported by independent Sentinel-2 spectral indices.
//
// ------------------------------------------------------------


// ------------------------------------------------------------
// 26. FUNCTION TO ADD NDVI + MNDWI
// ------------------------------------------------------------
//
// Sentinel-2:
// NDVI  = (B8 - B4) / (B8 + B4)
//
// MNDWI = (B3 - B11) / (B3 + B11)
//
// B8  = Near Infrared
// B4  = Red
// B3  = Green
// B11 = SWIR
// ------------------------------------------------------------

var addIndices = function(image) {

  var ndvi = image
    .normalizedDifference([
      'B8',
      'B4'
    ])
    .rename('NDVI');


  var mndwi = image
    .normalizedDifference([
      'B3',
      'B11'
    ])
    .rename('MNDWI');


  return image
    .addBands(ndvi)
    .addBands(mndwi);

};


// ------------------------------------------------------------
// 27. ADD INDICES TO 2023, 2024, 2025 COMPOSITES
// ------------------------------------------------------------

var index2023 = addIndices(
  s2_2023
);

var index2024 = addIndices(
  s2_2024
);

var index2025 = addIndices(
  s2_2025
);


// ------------------------------------------------------------
// 28. VISUALIZE NDVI
// ------------------------------------------------------------

var ndviVis = {

  min: 0,

  max: 0.8,

  palette: [
    'white',
    'yellow',
    'lightgreen',
    'darkgreen'
  ]

};


Map.addLayer(
  index2023.select('NDVI'),
  ndviVis,
  'NDVI — 2023',
  false
);


Map.addLayer(
  index2024.select('NDVI'),
  ndviVis,
  'NDVI — 2024',
  false
);


Map.addLayer(
  index2025.select('NDVI'),
  ndviVis,
  'NDVI — 2025',
  false
);


// ------------------------------------------------------------
// 29. VISUALIZE MNDWI
// ------------------------------------------------------------

var mndwiVis = {

  min: -0.5,

  max: 0.5,

  palette: [
    'brown',
    'white',
    'lightblue',
    'blue'
  ]

};


Map.addLayer(
  index2023.select('MNDWI'),
